flowchart TD
    Start(["User Accesses Web Console\n(https://iris-flower-classifier-z98q.onrender.com)"]) --> SelectMode{"Select Mode / Navigation"}

    SelectMode -->|"Tab 1: Numeric Form"| FormInput["Enter Measurements\n(SL, SW, PL, PW in cm)\nor Select 1-Click Preset"]
    SelectMode -->|"Tab 2: Image Upload"| ImageInput["Upload Flower Image\n(JPEG / PNG / WebP)"]
    SelectMode -->|"Tab 3: Test Set"| BatchInput["Upload Test Set CSV\nor Load 30-Sample Benchmark"]
    SelectMode -->|"Tab 4: EDA / PCA / Report"| AnalyticsInput["Navigate to EDA, PCA,\nor Model Report Dashboard"]

    %% Branch 1: Form
    FormInput --> ValidateForm{"Frontend Validation\n(Numeric & In Range?)"}
    ValidateForm -->|"Invalid"| FormError["Display Input Error Prompt"]
    ValidateForm -->|"Valid"| PostPredict["POST /api/predict\nPayload: JSON {SL, SW, PL, PW}"]
    PostPredict --> ServerVal{"Server Validation\n(utils/preprocess.py)"}
    ServerVal -->|"Fail"| APIError400["HTTP 400 Bad Request"]
    ServerVal -->|"Pass"| ScaleFeature["StandardScaler.transform()\nNormalized Vector (1, 4)"]
    ScaleFeature --> NNInference["PyTorch IrisNet Forward Pass\nLinear -> BN -> ReLU -> Dropout"]
    NNInference --> Softmax["Softmax Probability Computation\nget_probabilities(logits)"]
    Softmax --> JSONResp["Return JSON Response\n(Predicted Class, Confidence, Probabilities)"]
    JSONResp --> RenderCard["Render Dynamic ClassBadge\n& Animated Probability Bars"]

    %% Branch 2: Image
    ImageInput --> PostImage["POST /api/predict-image\nMultipart File or Base64"]
    PostImage --> PILProcess["PIL Image Decode & Normalization\nResize to 128x128 RGB"]
    PILProcess --> FeatureExtract["Extract Morphological & Color Metrics\n(Aspect Ratio, Violet/Blue Ratio, Petal Estimation)"]
    FeatureExtract --> ScaleFeature

    %% Branch 3: Batch Test Set
    BatchInput --> PostBatch["POST /api/evaluate-testset\n(CSV File / JSON Samples)"]
    PostBatch --> CheckColumns{"Verify Columns\n(SL, SW, PL, PW present?)"}
    CheckColumns -->|"No"| BatchError["HTTP 400 Missing Feature Columns"]
    CheckColumns -->|"Yes"| BatchScale["Batch StandardScaler.transform()"]
    BatchScale --> BatchInfer["PyTorch Batch Inference (N, 4) -> (N, 3)"]
    BatchInfer --> GroundTruthCheck{"Ground Truth\nLabels Included?"}
    GroundTruthCheck -->|"Yes"| CalcMetrics["Compute Accuracy, Precision,\nRecall, F1-Score & Confusion Matrix"]
    CalcMetrics --> GenCMChart["Generate Dark Theme Confusion Matrix\n(Seaborn Heatmap -> Base64 PNG)"]
    GroundTruthCheck -->|"No"| GenSummary["Generate Predictions Summary"]
    GenCMChart --> BatchResponse["Return Evaluation JSON\n(Metrics, CM Chart, Sample Predictions)"]
    GenSummary --> BatchResponse
    BatchResponse --> RenderBatchUI["Render MetricsTable, Confusion Matrix\n& Paginated Prediction Results"]

    %% Branch 4: Analytics
    AnalyticsInput --> RequestAnalytics["GET /api/eda or /api/pca or /api/model-report"]
    RequestAnalytics --> AnalysisEngine["IrisAnalysis Engine Execution\n(sklearn PCA, Seaborn, Matplotlib Agg)"]
    AnalysisEngine --> RenderPlots["Render Figures in Dark Theme (#1a1a2e)\nConvert to BytesIO Buffer -> Base64"]
    RenderPlots --> ReturnCharts["Return JSON with Base64 Encoded PNGs"]
    ReturnCharts --> DisplayCards["Frontend ChartCard Component\nDisplays High-DPI Charts with Skeleton Loader"]
