flowchart TD
    Start(["Raw Iris Dataset\n(150 Samples, 4 Features, 3 Classes)"]) --> Split["Stratified Split (random_state=42)"]

    subgraph Splits ["Data Partitioning"]
        TrainSplit["Training Set\n70% (105 samples)"]
        ValSplit["Validation Set\n15% (22 samples)"]
        TestSplit["Held-Out Test Set\n15% (23 samples)"]
    end

    Split --> TrainSplit
    Split --> ValSplit
    Split --> TestSplit

    TrainSplit --> FitScaler["StandardScaler.fit_transform()"]
    FitScaler --> SaveScaler[("Save scaler.joblib")]

    ValSplit --> ApplyVal["StandardScaler.transform()"]
    TestSplit --> ApplyTest["StandardScaler.transform()"]
    FitScaler -.-> ApplyVal
    FitScaler -.-> ApplyTest

    ApplyTest --> SaveTest[("Save test_data.joblib")]

    TrainSplit --> TrainLoader["Train DataLoader\n(batch_size=32, shuffle=True)"]
    ApplyVal --> ValLoader["Validation DataLoader\n(batch_size=22)"]
    ApplyTest --> TestLoader["Test DataLoader\n(batch_size=23)"]

    subgraph TrainingLoop ["PyTorch Training Loop with Early Stopping"]
        direction TB
        Epoch["Epoch t (1 to 300)"] --> Forward["Forward Pass (IrisNet)\nLinear -> BN -> ReLU -> Dropout"]
        Forward --> Loss["Compute CrossEntropyLoss"]
        Loss --> Backward["Adam Optimizer Step\n(lr=0.001, weight_decay=1e-4)"]
        Backward --> EvalVal["Evaluate on Validation Set\nCompute val_loss & val_acc"]
        EvalVal --> Scheduler["ReduceLROnPlateau\n(patience=10, factor=0.5)"]
        Scheduler --> CheckBest{"val_loss < best_loss?"}
        CheckBest -->|"Yes"| SaveCheckpoint["Update Best Weights Checkpoint\nReset es_counter = 0"]
        CheckBest -->|"No"| IncrementES["es_counter += 1"]
        IncrementES --> CheckPatience{"es_counter >= 20?"}
        CheckPatience -->|"No"| NextEpoch["Next Epoch"] --> Epoch
        CheckPatience -->|"Yes"| Stop["Early Stopping Triggered\n(Halted at Epoch 77)"]
        SaveCheckpoint --> NextEpoch
    end

    TrainLoader --> TrainingLoop
    ValLoader --> TrainingLoop

    Stop --> LoadBest["Load Best Model Weights Checkpoint"]
    LoadBest --> SaveModel[("Save iris_nn.pth")]

    LoadBest --> TestEval["Final Evaluation on Held-Out Test Set (TestLoader)"]
    TestEval --> ComputeAccuracy["Test Accuracy: 95.65%"]
    TestEval --> ComputeReport["Sklearn Classification Report\n(Precision, Recall, F1, Support)"]
    TestEval --> ComputeCM["Confusion Matrix Evaluation\n(3x3 Class Performance)"]

    ComputeAccuracy --> SaveHistory[("Save training_history.joblib")]
    ComputeCM --> SaveCM[("Save confusion_matrix.joblib")]

    subgraph LiveValidation ["Web Production Live Validation Pipeline"]
        direction TB
        LiveInput["User / Test Runner via Web Console"] --> TestAPI["POST /api/evaluate-testset"]
        TestAPI --> WebScale["StandardScaler.transform()"]
        WebScale --> WebInfer["PyTorch IrisNet Forward Pass"]
        WebInfer --> WebReport["Dynamic Classification Report & Confusion Matrix"]
    end

    SaveModel -.-> WebInfer
    SaveScaler -.-> WebScale
